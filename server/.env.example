# ---------- Server ----------

# Port used by the Express server
PORT=3000

# Use "development" when running the project locally
NODE_ENV=development

# ---------- PostgreSQL ----------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# ---------- Sessions ----------

# Replace with a sufficiently long random value.
SESSION_SECRET=replace_with_a_random_secret